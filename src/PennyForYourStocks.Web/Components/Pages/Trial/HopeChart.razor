@inject IJSRuntime Js

<div class="trial-card">
    <h2 class="mb-2 font-medium">Hope comparison (text summary)</h2>
    <p class="text-sm">@Summary.HopeBandLabel</p>
    <p class="text-sm">Average monthly withdrawal observed: £@Summary.OverallAverageMonthlyWithdrawal.ToString("0.00")</p>
    <ul class="mt-2 text-sm">
        @foreach (var bucket in Summary.MonthlyBuckets)
        {
            <li>@bucket.YearMonth: £@bucket.TotalWithdrawn.ToString("0.00")</li>
        }
    </ul>
    <canvas @ref="canvasRef" aria-hidden="true" class="mt-4 max-h-64"></canvas>
    <p class="mt-2 text-xs text-slate-600">@Summary.ObservationNote</p>
</div>

@code {
    [Parameter, EditorRequired] public Application.Models.HopeSummaryDto Summary { get; set; } = default!;

    private ElementReference canvasRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var labels = Summary.MonthlyBuckets.Select(b => b.YearMonth).ToArray();
            var values = Summary.MonthlyBuckets.Select(b => (double)b.TotalWithdrawn).ToArray();
            await Js.InvokeVoidAsync("hopeChart.render", canvasRef, labels, values);
        }
    }
}
